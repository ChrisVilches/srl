{
  "name": "srl-web",
  "version": "0.1.0",
  "description": "A web viewer for srl: a local server and a React frontend",
  "private": true,
  "type": "module",
  "bin": {
    "srl-web": "bin/srl-web.js"
  },
  "files": [
    "bin",
    "server",
    "dist"
  ],
  "scripts": {
    "dev": "node server/dev.js",
    "build": "tsc --noEmit && vite build",
    "start": "node bin/srl-web.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22.22"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-mono": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "@tanstack/react-query": "^5.107.1",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
